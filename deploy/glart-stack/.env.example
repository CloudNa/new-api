GLART_DOMAIN=api.glart.cn
ACME_EMAIL=admin@example.com
TZ=Asia/Shanghai

NEW_API_VERSION=glart-clean
SESSION_SECRET=change-me-to-a-long-random-string
SQLITE_PATH=/data/new-api.db?_busy_timeout=30000
REDIS_PASSWORD=change-me-redis-password

GPT_LOAD_AUTH_KEY=change-me-gpt-load-auth-key
GPT_LOAD_ENCRYPTION_KEY=change-me-gpt-load-encryption-key

CLIPROXYAPI_MANAGEMENT_KEY=change-me-cliproxyapi-management-key
CLIPROXYAPI_API_KEY=change-me-cliproxyapi-api-key

GLART_STACK_UPDATER_TOKEN=change-me-updater-token
GLART_STACK_RUN_TESTS=1
GLART_STACK_GO_TEST_IMAGE=golang:1.26.1
GLART_STACK_HOST_ROOT=/opt/glart-api/app

# Optional: enable post-update proxy-test chat smoke without committing secrets.
# Put the real API key only in the private server .env file.
GLART_SMOKE_MODEL=
GLART_SMOKE_API_KEY=
